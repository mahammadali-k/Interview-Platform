PORT=3000
NODE_ENV=development

DB_URL=your_mongodb_connection_url

INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret

CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

CLIENT_URL=http://localhost:5173

# --- Code execution (runs in a remote sandbox, never on this server) ---
# "judge0" (default, free public instance) or "piston" (the public Piston API is whitelist-only,
# so point PISTON_URL to your own instance)
CODE_RUNNER=judge0
JUDGE0_URL=https://ce.judge0.com
# JUDGE0_API_KEY=
# JUDGE0_API_HOST=
# PISTON_URL=http://localhost:2000/api/v2
# PISTON_API_KEY=

# --- Feedback emails (any SMTP provider; leave SMTP_HOST empty to disable) ---
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
#        SMTP_PASS=<16-character app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="IP Interview Platform <you@example.com>"
